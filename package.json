    "history:cost": "node scripts/history-cost.mjs",
    "test:plugins-v2": "node --test scripts/test-plugin-api.mjs scripts/test-plugin-ui-lifecycle.mjs scripts/test-plugin-frame.mjs scripts/test-plugin-contract.mjs scripts/test-source-plugin-zip.mjs scripts/test-fish-notebook-plugin.mjs scripts/test-speech-recognition.mjs scripts/test-voice-input.mjs scripts/test-speech-diagnostics.mjs scripts/test-speech-setup.mjs scripts/test-speech-plugin-standalone.mjs scripts/test-voice-codec.mjs scripts/test-speech-protocol.mjs",
    "test:fish-notebook-plugin": "node --test scripts/test-fish-notebook-plugin.mjs",
    "test:speech-recognition": "node --test scripts/test-speech-recognition.mjs scripts/test-voice-input.mjs scripts/test-speech-diagnostics.mjs scripts/test-speech-setup.mjs scripts/test-speech-plugin-standalone.mjs scripts/test-voice-codec.mjs scripts/test-speech-protocol.mjs",
    "test:plugin-contract": "node --test scripts/test-plugin-contract.mjs scripts/test-source-plugin-zip.mjs",
    "plugin:check": "node scripts/plugin-host-check.mjs",
    "plugin:pack": "node scripts/pack-bundled-plugins.mjs",
    "source:check": "node scripts/public-source-check.mjs",
    "source:build": "node scripts/build-source-release.mjs",
    "release:verify": "node scripts/verify-plugin-release.mjs",
    "test:speech-diagnostics": "node --test scripts/test-speech-diagnostics.mjs scripts/test-speech-setup.mjs scripts/test-speech-plugin-standalone.mjs",
    "test:voice-codec": "node --test scripts/test-voice-codec.mjs",
    "test:speech-protocol": "node --test scripts/test-speech-protocol.mjs",
    "test:release-version": "node --test scripts/test-release-version.mjs scripts/test-public-update-check.mjs",
    "test:sessions": "node --test scripts/test-dsh-sessions-cli.mjs",
    "desktop:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-desktop.ps1",
    "desktop:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-sender/build-native.ps1 -SelfTest",
    "desktop:check": "node scripts/wechat-onebot.mjs --check",
    "test:desktop-sender": "node --test scripts/desktop-sender/test-*.mjs scripts/test-desktop-*.mjs",
    "format:desktop": "node scripts/format-desktop.mjs",
    "format:desktop:check": "node scripts/format-desktop.mjs --check",
    "test:node": "node scripts/run-tests.mjs --node",
    "test:python": "node scripts/run-tests.mjs --python",
    "test:integration": "node scripts/run-tests.mjs --require-sdk",
    "desktop:draft-inspect": "node scripts/desktop-sender/draft-probe.mjs --inspect",
    "desktop:window-probe": "node scripts/window-message-probe.mjs",
    "media:prepare": "python scripts/prepare-local-whisper.py --download",
    "media:check": "python scripts/prepare-local-whisper.py"
