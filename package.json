  "devDependencies": {
    "@electron/asar": "3.4.1",
    "7zip-bin": "5.2.0",
    "electron": "43.8.12",
    "electron-builder": "26.18.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "resedit": "1.7.2",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.9"
  },
  "releaseVersion": "0.4.6"
}
