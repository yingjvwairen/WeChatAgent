    "test:storage": "node --test scripts/test-installer-directory.mjs scripts/test-data-storage.mjs scripts/test-storage-runtime.mjs",
    "test:startup": "node --test scripts/test-adapter-startup.mjs scripts/test-process-recovery.mjs",
    "test:reply-protocol": "node --test scripts/test-reply-protocol.mjs",
    "test:prompt-policy": "node --test scripts/test-prompt-policy.mjs",
    "test:persona-delete": "node --test scripts/test-persona-delete.mjs",
    "test:external-dsh": "node --test scripts/test-external-dsh.mjs",
    "test:wechat-account": "node --test scripts/test-wechat-account-check.mjs scripts/test-reader-account-state.mjs",
    "test:session-groups": "node --test scripts/test-session-groups.mjs scripts/test-native-session.mjs",
    "test:followup": "node --test scripts/test-followup-dedup.mjs scripts/test-plugin-client.mjs scripts/test-native-session.mjs",
    "test:personas": "node --test scripts/test-persona-categories.mjs scripts/test-persona-delete.mjs",
    "test:requests": "node --test scripts/test-request-admission.mjs scripts/test-plugin-client.mjs scripts/test-native-session.mjs",
    "test:assistant": "node --test scripts/test-assistant-mode.mjs scripts/test-native-session.mjs scripts/test-assistant-controller.mjs scripts/test-assistant-access.mjs scripts/test-assistant-feedback.mjs",
