{
  "name": "wechatagent",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "description": "Personal WeChat AI friend with a local reader, guarded desktop sender, GPT-SoVITS voice and an existing DSH Desktop",
  "license": "SEE LICENSES.md",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "qt:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-qt-actions.ps1 -SelfTest",
    "qt:calibrate": "node scripts/qt-calibrate.mjs",
    "secondary:configure": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/secondary-computer.ps1 -Task configure",
    "secondary:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/secondary-computer.ps1 -Task prepare-components",
    "secondary:export": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/export-secondary.ps1",
    "test:bot-controls": "node --test scripts/test-bot-controls.mjs scripts/test-ui-runtime-controls.mjs scripts/test-ui-reader-recovery.mjs",
    "test:ui-service": "node --test scripts/test-ui-service.mjs scripts/test-ui-reader-stream.mjs scripts/test-ui-reply-outbox.mjs scripts/test-native-voice-outbox.mjs scripts/test-native-voice-transport.mjs",
    "ui:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-ui-host.ps1",
    "ui:demo": "node scripts/ui-preview.mjs demo",
    "visual:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-visual-probe.ps1",
    "frame:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-frame-capture.ps1",
    "account:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-account-probe.ps1",
    "draft:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-draft-probe.ps1",
    "contact:inspect": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/ui-runtime.ps1 -Task contact-identity",
    "draft:inspect": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/ui-runtime.ps1 -Task draft-probe",
    "ui:runtime-check": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/ui-runtime.ps1 -Task check",
    "test:ui-bridge": "node --test scripts/test-ui-onebot.mjs scripts/test-ui-reader-receipts.mjs scripts/test-durable-ui-delivery.mjs",
    "test:reader-local": "node --test scripts/test-reader-local-setup.mjs scripts/test-reader-setup-lifecycle.mjs scripts/test-reader-local-api.mjs",
    "audio:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-audio-probe.ps1",
    "voice:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-voice-probe.ps1 -SelfTest",
    "audio:devices": "node scripts/ui-preview.mjs audio-devices",
    "media:prepare": "node scripts/prepare-local-media.mjs --download",
    "media:check": "node scripts/prepare-local-media.mjs",
    "test:incoming-media": "node --test scripts/test-media-input.mjs scripts/test-wechat-av.mjs scripts/test-wechat-nested-media.mjs scripts/test-ui-incoming-content.mjs scripts/test-reader-target-service.mjs scripts/test-ui-reader-media-proxy.mjs scripts/test-image-input.mjs",
    "test:media-probes": "node --test scripts/test-visual-probe.mjs scripts/test-audio-probe.mjs scripts/test-frame-capture.mjs scripts/test-frame-probe.mjs scripts/test-account-probe.mjs",
    "test:ui-input": "node --test scripts/test-ui-text-outbox.mjs scripts/test-ui-host-client.mjs scripts/test-ui-host.mjs",
    "test:ui-identity": "node --test scripts/test-contact-identity.mjs scripts/test-draft-probe.mjs scripts/test-ui-runtime.mjs",
    "voice:preview": "node scripts/voice-preview.mjs",
    "dania:start": "node scripts/dania-start.mjs",
    "test:voice": "node --test scripts/test-voice-synthesis.mjs scripts/test-voice-preview.mjs scripts/test-cable-player.mjs scripts/test-ui-voice-session.mjs scripts/test-timed-voice-preview.mjs",
    "console": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/launch-desktop.ps1",
    "desktop:build": "node scripts/build-desktop.mjs",
    "installer:runtime": "node scripts/prepare-installer-runtime.mjs",
    "installer:build": "node scripts/build-installer.mjs",
    "console:web": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/launch-console.ps1",
    "start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/manage.ps1 start",
    "stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/manage.ps1 stop",
    "restart": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/manage.ps1 restart",
    "status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/manage.ps1 status",
    "friend-ids": "node scripts/list-friend-ids.mjs",
    "sessions:configure": "node scripts/manage-dsh-sessions.mjs configure",
    "sessions:compact": "node scripts/manage-dsh-sessions.mjs compact",
    "sessions:status": "node scripts/manage-dsh-sessions.mjs status",
    "controls:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-accessibility-gate.ps1 -SelfTest && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-background-controls.ps1 -SelfTest",
    "controls:inspect": "node scripts/background-controls.mjs",
    "test:uia": "node --test scripts/test-uia-mode.mjs scripts/test-uia-mode-runtime.mjs scripts/test-background-controls.mjs scripts/test-qt-layout-profiles.mjs scripts/test-qt-visual-driver.mjs scripts/test-runtime-interaction-policy.mjs scripts/test-ui-service.mjs",
    "test:background-controls": "node --test scripts/test-background-controls.mjs",
    "setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "privacy:check": "node scripts/public-source-check.mjs",
    "test:shutdown": "node --test scripts/test-desktop-shutdown.mjs scripts/test-desktop-lifecycle.mjs",
    "test:storage": "node --test scripts/test-installer-directory.mjs scripts/test-data-storage.mjs scripts/test-storage-runtime.mjs",
    "test:startup": "node --test scripts/test-ui-service.mjs scripts/test-process-recovery.mjs",
    "test:reply-protocol": "node --test scripts/test-reply-protocol.mjs",
    "test:prompt-policy": "node --test scripts/test-prompt-policy.mjs",
    "test:persona-delete": "node --test scripts/test-persona-delete.mjs",
    "test:external-dsh": "node --test scripts/test-external-dsh.mjs",
    "test:wechat-account": "node --test scripts/test-account-probe.mjs scripts/test-reader-account-state.mjs",
    "test:session-groups": "node --test scripts/test-session-groups.mjs scripts/test-native-session.mjs",
    "test:followup": "node --test scripts/test-followup-dedup.mjs scripts/test-plugin-client.mjs scripts/test-native-session.mjs",
    "test:personas": "node --test scripts/test-persona-categories.mjs scripts/test-persona-delete.mjs",
    "test:requests": "node --test scripts/test-request-admission.mjs scripts/test-plugin-client.mjs scripts/test-native-session.mjs",
    "test:assistant": "node --test scripts/test-assistant-mode.mjs scripts/test-native-session.mjs scripts/test-assistant-controller.mjs scripts/test-assistant-access.mjs scripts/test-assistant-feedback.mjs",
    "test:catalog": "node --test scripts/test-plugin-catalog.mjs scripts/test-extension-page.mjs scripts/test-persona-categories.mjs",
    "test:assistant-access": "node --test scripts/test-assistant-access.mjs scripts/test-assistant-mode.mjs scripts/test-native-session.mjs",
    "test": "node --test scripts/test-*.mjs",
    "test:assistant-controller": "node --test scripts/test-assistant-controller.mjs scripts/test-assistant-mode.mjs scripts/test-assistant-access.mjs scripts/test-file-transfers.mjs scripts/test-assistant-feedback.mjs",
    "test:assistant-feedback": "node --test scripts/test-assistant-feedback.mjs",
    "test:layout": "node --test scripts/test-workspace-layout.mjs scripts/test-extension-page.mjs",
    "test:history": "node --test scripts/test-request-window.mjs scripts/test-window-reply-dedup.mjs scripts/test-history.mjs scripts/test-cost-next.mjs",
    "history:cost": "node scripts/history-cost.mjs",
    "test:plugins-v2": "node --test scripts/test-plugin-api.mjs scripts/test-fish-notebook-plugin.mjs",
    "test:fish-notebook-plugin": "node --test scripts/test-fish-notebook-plugin.mjs"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "7zip-bin": "5.2.0",
    "electron": "41.1.1",
    "electron-builder": "26.8.1",
    "sharp": "0.34.5",
    "resedit": "1.7.2"
  }
}
